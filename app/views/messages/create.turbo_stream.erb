<% if @message.persisted? %>
  <%= turbo_stream.remove "no_messages" %>
  <%= turbo_stream.replace "new_message_form" do %>
    <%= render "messages/form", participation: @participation, message: Message.new %>
  <% end %>
<% else %>
  <%= turbo_stream.replace "new_message_form" do %>
    <%= render "messages/form", participation: @participation, message: @message %>
  <% end %>
<% end %>
