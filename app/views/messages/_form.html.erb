<% target = local_assigns[:assignment] || local_assigns[:participation] %>
<%= turbo_frame_tag "new_message_form" do %>
  <%= form_with(model: [target, message], id: "message_form") do |form| %>
    <% if message.errors.any? %>
      <div class="alert-error" style="margin-bottom: 1rem;">
        <% message.errors.full_messages.each do |error| %>
          <div><%= error %></div>
        <% end %>
      </div>
    <% end %>

    <div class="field">
      <%= form.text_area :body,
                         rows: 3,
                         placeholder: "Напишите сообщение...",
                         id: "message_body",
                         data: { action: "keydown->chat#submit" } %>
    </div>
    <%= form.submit "Отправить сообщение", class: "btn btn-primary" %>
  <% end %>
<% end %>