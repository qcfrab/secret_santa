<% content_for :title, "Редактирование профиля" %>

<h1>Редактирование профиля</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :nickname, "Ваш никнейм (имя для других участников)" %>
    <%= f.text_field :nickname, autofocus: true, placeholder: "Например: Тайный Эльф" %>
  </div>

  <div class="field">
    <%= f.label :email, "Электронная почта" %>
    <%= f.email_field :email, autocomplete: "email" %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <p style="color: var(--text-muted); font-size: 0.9rem;">
      Ожидает подтверждения новый адрес: <%= resource.unconfirmed_email %>
    </p>
  <% end %>

  <div class="field">
    <%= f.label :password, "Новый пароль" %>
    <small style="display: block; color: var(--text-muted); margin-bottom: 0.3rem;">
      (оставьте пустым, если не хотите менять)
    </small>
    <%= f.password_field :password, autocomplete: "new-password" %>
    <% if @minimum_password_length %>
      <small style="color: var(--text-muted); font-size: 0.85rem;">
        Минимум <%= @minimum_password_length %> символов
      </small>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "Подтверждение нового пароля" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="field" style="margin-top: 1.25rem;">
    <%= f.label :current_password, "Текущий пароль" %>
    <small style="display: block; color: var(--text-muted); margin-bottom: 0.3rem;">
      (требуется для подтверждения изменений)
    </small>
    <%= f.password_field :current_password, autocomplete: "current-password" %>
  </div>

  <div style="margin-top: 1.5rem; display: flex; gap: 0.75rem; align-items: center;">
    <%= f.submit "Сохранить изменения", class: "btn btn-primary" %>
    <%= link_to "Назад", :back, class: "btn btn-outline" %>
  </div>
<% end %>

<hr style="border: none; border-top: 1px solid var(--accent); margin: 2rem 0 1.5rem 0;">

<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h3 style="margin-bottom: 0.2rem; font-size: 1.1rem;">Удаление аккаунта</h3>
    <span style="font-size: 0.85rem; color: var(--text-muted);">Действие необратимо</span>
  </div>
  <%= button_to "Удалить аккаунт", registration_path(resource_name), data: { confirm: "Вы уверены?", turbo_confirm: "Вы уверены?" }, method: :delete, class: "btn btn-danger btn-sm" %>
</div>