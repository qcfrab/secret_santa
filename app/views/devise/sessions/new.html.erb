<% content_for :title, "Вход в аккаунт" %>

<h1>Вход</h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="field">
    <%= f.label :login, "Электронная почта или никнейм" %>
    <%= f.text_field :login, autofocus: true, autocomplete: "username"%>
  </div>

  <div class="field">
    <%= f.label :password, "Пароль" %>
    <%= f.password_field :password, autocomplete: "current-password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field" style="display: flex; align-items: center; gap: 0.5rem;">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, "Запомнить меня", style: "margin-bottom: 0; font-weight: normal; cursor: pointer;" %>
    </div>
  <% end %>

  <div style="margin-top: 1.5rem;">
    <%= f.submit "Войти", class: "btn btn-primary", style: "width: 100%;" %>
  </div>
<% end %>

<div style="margin-top: 1.25rem; text-align: center;">
  <%= render "devise/shared/links" %>
</div>