<p><%= link_to "← К списку игр", events_path %></p>

<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
    <h1 style="margin-bottom: 0.25rem;"><%= @event.name %></h1>
    <span class="badge <%= @event.drawn? ? 'badge-drawn' : 'badge-waiting' %>">
      <%= @event.drawn? ? "✓ Жеребьёвка проведена" : "⏳ Набор участников" %>
    </span>
  </div>

  <% if @event.description.present? %>
    <p style="margin-top: 0.75rem;"><%= @event.description %></p>
  <% end %>

  <div class="event-meta">
    <% if @event.budget %>
      <div>🎁 <strong>Бюджет:</strong> <%= @event.budget %> ₽</div>
    <% end %>
    <% if @event.exchange_date %>
      <div>📅 <strong>Дата обмена:</strong> <%= @event.exchange_date %></div>
    <% end %>
    <div>👥 <strong>Участников:</strong> <%= @event.users.count %></div>
  </div>

  <h3>Участники (<%= @event.users.count %>)</h3>
  <ul class="participants-list">
    <% @event.users.each do |user| %>
      <li class="participant-chip <%= 'organizer' if user == @event.organizer %>">
        <%= user.display_name %><%= " ★ организатор" if user == @event.organizer %>
      </li>
    <% end %>
  </ul>

  <% if @event.waiting? %>
    <div class="field" style="margin-top: 1.5rem;">
      <label>Ссылка-приглашение для друзей:</label>
      <input type="text" value="<%= join_url(code: @event.invite_code) %>" readonly onclick="this.select()">
    </div>
  <% end %>

  <% if current_user == @event.organizer && @event.waiting? %>
    <% if @event.can_draw? %>
      <%= button_to "🎲 Провести жеребьёвку", draw_event_path(@event), class: "btn btn-primary" %>
    <% else %>
      <p style="color: var(--text-muted); margin-bottom: 0;">
        Для проведения жеребьёвки нужно минимум <%= Event::MIN_PARTICIPANTS %> участника.
      </p>
    <% end %>
  <% end %>
</div>

<% if @event.drawn? %>
  <div class="events-grid">
    <% if @santa_assignment %>
      <div class="card">
        <span class="badge badge-waiting" style="margin-bottom: 0.75rem;">Миссия Санты</span>
        <h2>Вы дарите подарок: <%= @santa_assignment.giftee.display_name %></h2>
        <p style="color: var(--text-muted);">Изучите вишлист получателя или задайте анонимный вопрос в чате.</p>
        <%= link_to "Вишлист и чат →", assignment_path(@santa_assignment), class: "btn btn-primary" %>
      </div>
    <% end %>

    <% if @giftee_assignment %>
      <div class="card">
        <span class="badge badge-drawn" style="margin-bottom: 0.75rem;">Ваш даритель</span>
        <h2>Чат с вашим Тайным Сантой</h2>
        <p style="color: var(--text-muted);">Санта остаётся анонимным, но вы можете переписываться с ним здесь.</p>
        <%= link_to "Открыть чат →", assignment_path(@giftee_assignment), class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
<% end %>

<% if current_user == @event.organizer %>
  <div data-controller="modal" style="margin-top: 2.5rem; display: flex; justify-content: flex-end;">
    <button type="button" class="btn btn-danger btn-sm" data-action="click->modal#open" onclick="document.getElementById('delete-modal')?.showModal()">
      Удалить игру
    </button>

    <dialog id="delete-modal" class="modal-dialog" data-modal-target="dialog" data-action="click->modal#backdropClose" onclick="if (event.target === this) this.close()">
      <div class="modal-card">
        <h3 class="modal-title">Удаление игры</h3>
        <p class="modal-body">Вы уверены, что хотите удалить игру? Это действие нельзя отменить.</p>
        <div class="modal-actions">
          <button type="button" class="btn btn-outline btn-sm" data-action="click->modal#close" onclick="this.closest('dialog').close()">
            Отмена
          </button>
          <%= button_to "Удалить", @event, method: :delete, class: "btn btn-danger btn-sm" %>
        </div>
      </div>
    </dialog>
  </div>
<% end %>
