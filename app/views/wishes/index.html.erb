<% content_for :title, "Мой вишлист" %>

<div class="page-header">
  <div>
    <h1>Мой вишлист</h1>
    <p style="color: var(--text-muted); margin-bottom: 0;">Расскажите Тайному Санте, о чём вы мечтаете</p>
  </div>
  <%= link_to "+ Добавить желание", new_wish_path, class: "btn btn-primary" %>
</div>

<% if @wishes.any? %>
  <div id="wishes" class="wishes-grid">
    <% @wishes.each do |wish| %>
      <%= render wish %>
    <% end %>
  </div>
<% else %>
  <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
    <h3>Ваш вишлист пока пуст</h3>
    <p style="color: var(--text-muted);">Добавьте хотя бы несколько идей, чтобы вашему Санте было проще выбрать подарок!</p>
    <%= link_to "Добавить первое желание", new_wish_path, class: "btn btn-primary" %>
  </div>
<% end %>

<% if @total_pages > 1 %>
  <nav class="pagination" aria-label="Пагинация вишлиста">
    <% if @page > 1 %>
      <%= link_to "← Назад", wishes_path(page: @page - 1), class: "page-link" %>
    <% else %>
      <span class="page-link disabled">← Назад</span>
    <% end %>

    <% (1..@total_pages).each do |p| %>
      <%= link_to p, wishes_path(page: p), class: "page-link #{'active' if p == @page}" %>
    <% end %>

    <% if @page < @total_pages %>
      <%= link_to "Вперёд →", wishes_path(page: @page + 1), class: "page-link" %>
    <% else %>
      <span class="page-link disabled">Вперёд →</span>
    <% end %>
  </nav>
<% end %>