<%= form_with(model: wish) do |form| %>
  <div class="field <%= 'field-error' if wish.errors[:title].any? %>">
    <%= form.label :title, "Название подарка" %>
    <%= form.text_field :title, placeholder: "Например: Виниловая пластинка или тёплый шарф" %>
    <% if wish.errors[:title].any? %>
      <span class="error-text"><%= wish.errors[:title].first %></span>
    <% end %>
  </div>

  <div class="field">
    <%= form.label :description, "Описание (цвет, размер, пожелания)" %>
    <%= form.text_area :description, rows: 3, placeholder: "Любые детали, которые помогут не ошибиться с выбором..." %>
  </div>

  <div class="field">
    <%= form.label :url, "Ссылка на магазин / маркетплейс" %>
    <%= form.text_field :url, placeholder: "https://..." %>
  </div>

  <div class="field">
    <%= form.label :image, "Загрузить картинку подарка" %>
    <%= form.file_field :image, accept: "image/png, image/jpeg, image/jpg, image/webp", class: "file-input" %>
  </div>

  <div style="display: flex; gap: 0.75rem; align-items: center; margin-top: 1.5rem;">
    <%= form.submit "Сохранить желание", class: "btn btn-primary" %>
    <%= link_to "Отмена", wishes_path, class: "btn btn-outline" %>
  </div>
<% end %>